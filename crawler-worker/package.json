{
  "name": "pdf-finder-crawler-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run test && npm run typecheck",
    "start": "node --experimental-strip-types src/main.ts",
    "migrate": "node --experimental-strip-types src/migrate.ts"
  },
  "dependencies": {
    "crawlee": "3.18.1",
    "pg": "8.16.3",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "typescript": "5.9.2"
  }
}
